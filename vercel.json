{
  "redirects": [
    {
      "source": "/cresedona.com",
      "destination": "https://www.crescendona.com",
      "permanent": true
    },
    {
      "source": "/www.cresedona.com",
      "destination": "https://www.crescendona.com",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
